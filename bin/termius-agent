#!/usr/bin/env bash
# Termius Agent Launcher

# Resolve true project directory even when called via symlink
REAL_SCRIPT="$(realpath "${BASH_SOURCE[0]}")"
APP_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." >/dev/null 2>&1 && pwd)"
PORT=3001

MODE="desktop"
for arg in "$@"; do
  case "$arg" in
    --web|--browser)
      MODE="web"
      ;;
    --desktop)
      MODE="desktop"
      ;;
  esac
done

# If no graphical display available, force web mode
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
  MODE="web"
fi

# Default: Open native Electron App
if [ "$MODE" = "desktop" ] && [ -x "$APP_DIR/termius-agent-app.sh" ]; then
  exec "$APP_DIR/termius-agent-app.sh" "$@"
fi

# Fallback or explicit web mode: Open in browser
if ! ss -tulpn 2>/dev/null | grep -q ":$PORT "; then
  echo "==> Iniciando backend do Termius Agent na porta $PORT..."
  cd "$APP_DIR" && nohup node server/index.js > /tmp/termius-agent.log 2>&1 &
  sleep 1.2
fi

echo "==> Abrindo Termius Agent no navegador em http://localhost:$PORT..."

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "http://localhost:$PORT" >/dev/null 2>&1 &
fi

echo "✔ Termius Agent ativo em http://localhost:$PORT"


